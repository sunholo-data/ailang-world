module sketches/storejournal

-- Compiler-checked sketch for w-store-durability (clause-1): the kernel
-- DURABILITY LAW across a crash. The store implementation is Go
-- (host/store); this sketch freezes the semantic laws the Go boundary
-- mirrors, exactly as worlddapi.ail froze the REST surface and
-- effectbroker.ail (planned) freezes the capability/budget law.
--
-- Four laws live here:
--   1. write-validity     — no ref column may persist the zero HashRef's
--                           rendering (the CF-B-2 poison, probed live);
--   2. the receipt law    — the three-state not-started / indeterminate /
--                           resolved contract, including the never-lie
--                           rule (never a definitive "not committed"
--                           while the outcome is unknown);
--   3. the retry gate     — an indeterminate intent is never re-executed
--                           without explicit reconciliation;
--   4. the binding law    — a commit resolves ONLY the intent whose
--                           commit-defining fields it matches, not merely
--                           the same invocation ID (quorum round 1,
--                           gpt5-6-sol).
--   5. effect dispatch    — dispatch requires a prior durable intent.
--
-- v0.30.0 verifier discipline (w-m1-ailang-hardening + w-effect-broker-m3
-- findings): total-theorem ensures only (no requires — U3), no contracted
-- callee calls inside contract-bearing bodies (U1 — bodies are inlined),
-- and string-projection outputs so tests[] never needs an ADT constructor
-- expected value (U2).

-- LAW 1 — write-validity floor. hashref.HashRef's zero value renders as ""
-- (host/hashref/hashref.go), and SQLite's TEXT NOT NULL is satisfied by ''
-- — so "no empty ref text" is exactly the floor that separates a readable
-- row from the CF-B-2 poison. Full canonicality (algo tag, digest width)
-- is host-side hashref.Parse; this predicate is the Z3-provable core the
-- Go validator mirrors for EVERY ref column Commit writes.
export func writableRefText(s: string) -> bool ! {}
ensures { result == (s != "") }
tests [
  ("", false),
  ("sha256:ab", true)
]
{
  s != ""
}

-- LAW 2a — the indeterminate state: a durable intent with no durable
-- outcome. This is the ONLY state in which the invocation's external
-- consequence is unknown.
export func isIndeterminate(hasIntent: bool, hasOutcome: bool) -> bool ! {}
ensures { result == (hasIntent && hasOutcome == false) }
tests [
  ((true, false), true),
  ((true, true), false),
  ((false, false), false)
]
{
  hasIntent && hasOutcome == false
}

-- LAW 2b — the never-lie rule (the w-mcp-projection round-2 objection,
-- gpt5-6-sol, adopted as kernel law): a caller may be given a definitive
-- "not committed / never executed" answer ONLY when no durable intent
-- exists. Once an intent is durable and the outcome is unknown, the only
-- truthful answer is indeterminate.
export func mayReportNotStarted(hasIntent: bool) -> bool ! {}
ensures { result == (hasIntent == false) }
tests [
  (false, true),
  (true, false)
]
{
  hasIntent == false
}

-- LAW 3 — the retry gate: re-execution of an intent is permitted only when
-- the intent is NOT indeterminate, or when it has been explicitly
-- reconciled (a per-handler reconciliation proved the effect did not
-- happen, or an operator resolved it). Automatic re-execution of an
-- indeterminate intent is structurally forbidden — the silent-duplicate-
-- execution risk the broker quorum named.
export func retryAllowed(indeterminate: bool, reconciled: bool) -> bool ! {}
ensures { result == (indeterminate == false || reconciled) }
tests [
  ((false, false), true),
  ((false, true), true),
  ((true, false), false),
  ((true, true), true)
]
{
  indeterminate == false || reconciled
}

-- LAW 4 — journal append discipline: sequence numbers are gapless and
-- start at 1, so "the journal since the last outcome" is a bounded,
-- well-defined walk (Standing Rule 6 applies to recovery too).
export func journalSeqNext(prevSeq: int, seq: int) -> bool ! {}
ensures { result == (seq == prevSeq + 1 && seq >= 1) }
tests [
  ((0, 1), true),
  ((1, 2), true),
  ((1, 3), false),
  ((-2, -1), false)
]
{
  seq == prevSeq + 1 && seq >= 1
}

-- LAW 5 — effect dispatch is lawful only when nothing was dispatched, or
-- when the effect intent was already durable. This is total: the forbidden
-- (dispatched, not durable) combination must remain representable and false.
export func effectDispatchLawful(dispatched: bool, intentDurable: bool) -> bool ! {}
ensures { result == (dispatched == false || intentDurable) }
tests [
  ((false, false), true),
  ((false, true), true),
  ((true, true), true),
  ((true, false), false)
]
{
  dispatched == false || intentDurable
}

-- LAW 6 — outcome binding, the IDENTITY half: an outcome resolves exactly
-- the intent whose invocation ID it names. Exact string equality — the
-- scope-matching discipline of the broker law, applied to invocation
-- identity. NOT sufficient alone for the commit path — LAW 6 is the
-- field-level half (quorum round 1: ID equality alone lets Commit(id, B)
-- claim resolution for a recorded intent A).
export func outcomeMatchesIntent(intentId: string, outcomeId: string) -> bool ! {}
ensures { result == (intentId == outcomeId) }
tests [
  (("inv-1", "inv-1"), true),
  (("inv-1", "inv-2"), false)
]
{
  intentId == outcomeId
}

-- LAW 7 — commit binding, the FIELD-LEVEL half (quorum round 1,
-- gpt5-6-sol, adopted as kernel law; WIDENED to the round-2 eight-field
-- list, gemini-3-1-pro, applied here iter-29 — the round-2 revision had
-- reached the prose but not this frozen artifact): a Commit carrying an
-- invocation ID may mutate the store ONLY when ALL EIGHT of its
-- commit-defining fields match the durable intent's planned fields by
-- exact canonical-text equality — invocation ID, planned next-world ref,
-- planned entry hash, observed head, planned prev-entry hash, transition
-- function name, transition ref, interpreter ref. AppendIntent(id, A)
-- followed by Commit(id, B) is a structured InvocationMismatchError and
-- leaves the store untouched; a receipt may never claim resolution for an
-- operation different from the recorded intent. The Go comparison runs
-- inside Commit's transaction, before any mutation, over the intent
-- object's canonical (golden-bytes) encoding.
-- tests[] carries ONE single-field mismatch row PER field, so a Go mirror
-- that silently drops ANY ONE of the eight reds a row of its own
-- (MUT-INTENT-NARROW-BIND must be individually load-bearing, not
-- collectively), PLUS the round-2 REQUIRED EntryHash-preserving row:
-- PrevEntryHash/TransitionFn/Interpreter drift while EntryHash stays
-- byte-identical — the exact shape a narrow binding waves through, since
-- V12 records that the kernel never derives EntryHash from entry
-- contents.
export func intentBindsCommit(intentId: string, commitId: string, iWorldRef: string, cWorldRef: string, iEntryHash: string, cEntryHash: string, iObservedHead: string, cObservedHead: string, iPrevEntryHash: string, cPrevEntryHash: string, iTransitionFn: string, cTransitionFn: string, iTransitionRef: string, cTransitionRef: string, iInterpreter: string, cInterpreter: string) -> bool ! {}
ensures { result == (intentId == commitId && iWorldRef == cWorldRef && iEntryHash == cEntryHash && iObservedHead == cObservedHead && iPrevEntryHash == cPrevEntryHash && iTransitionFn == cTransitionFn && iTransitionRef == cTransitionRef && iInterpreter == cInterpreter) }
tests [
  (("inv-1", "inv-1", "sha256:w1", "sha256:w1", "sha256:e1", "sha256:e1", "sha256:h0", "sha256:h0", "sha256:p0", "sha256:p0", "applyRevision", "applyRevision", "sha256:t1", "sha256:t1", "sha256:i1", "sha256:i1"), true),
  (("inv-1", "inv-2", "sha256:w1", "sha256:w1", "sha256:e1", "sha256:e1", "sha256:h0", "sha256:h0", "sha256:p0", "sha256:p0", "applyRevision", "applyRevision", "sha256:t1", "sha256:t1", "sha256:i1", "sha256:i1"), false),
  (("inv-1", "inv-1", "sha256:w1", "sha256:wB", "sha256:e1", "sha256:e1", "sha256:h0", "sha256:h0", "sha256:p0", "sha256:p0", "applyRevision", "applyRevision", "sha256:t1", "sha256:t1", "sha256:i1", "sha256:i1"), false),
  (("inv-1", "inv-1", "sha256:w1", "sha256:w1", "sha256:e1", "sha256:eB", "sha256:h0", "sha256:h0", "sha256:p0", "sha256:p0", "applyRevision", "applyRevision", "sha256:t1", "sha256:t1", "sha256:i1", "sha256:i1"), false),
  (("inv-1", "inv-1", "sha256:w1", "sha256:w1", "sha256:e1", "sha256:e1", "sha256:h0", "sha256:hB", "sha256:p0", "sha256:p0", "applyRevision", "applyRevision", "sha256:t1", "sha256:t1", "sha256:i1", "sha256:i1"), false),
  (("inv-1", "inv-1", "sha256:w1", "sha256:w1", "sha256:e1", "sha256:e1", "sha256:h0", "sha256:h0", "sha256:p0", "sha256:pB", "applyRevision", "applyRevision", "sha256:t1", "sha256:t1", "sha256:i1", "sha256:i1"), false),
  (("inv-1", "inv-1", "sha256:w1", "sha256:w1", "sha256:e1", "sha256:e1", "sha256:h0", "sha256:h0", "sha256:p0", "sha256:p0", "applyRevision", "applyRevisionB", "sha256:t1", "sha256:t1", "sha256:i1", "sha256:i1"), false),
  (("inv-1", "inv-1", "sha256:w1", "sha256:w1", "sha256:e1", "sha256:e1", "sha256:h0", "sha256:h0", "sha256:p0", "sha256:p0", "applyRevision", "applyRevision", "sha256:t1", "sha256:tB", "sha256:i1", "sha256:i1"), false),
  (("inv-1", "inv-1", "sha256:w1", "sha256:w1", "sha256:e1", "sha256:e1", "sha256:h0", "sha256:h0", "sha256:p0", "sha256:p0", "applyRevision", "applyRevision", "sha256:t1", "sha256:t1", "sha256:i1", "sha256:iB"), false),
  (("inv-1", "inv-1", "sha256:w1", "sha256:w1", "sha256:e1", "sha256:e1", "sha256:h0", "sha256:h0", "sha256:p0", "sha256:pB", "applyRevision", "applyRevisionB", "sha256:t1", "sha256:t1", "sha256:i1", "sha256:iB"), false)
]
{
  intentId == commitId && iWorldRef == cWorldRef && iEntryHash == cEntryHash && iObservedHead == cObservedHead && iPrevEntryHash == cPrevEntryHash && iTransitionFn == cTransitionFn && iTransitionRef == cTransitionRef && iInterpreter == cInterpreter
}

-- Canonical receipt-state projection (the queryable receipt's state field).
-- Tests-covered rather than contract-proven: the result is a canonical
-- TEXT form, so named tests are its machine check (S1 fallback), and the
-- three boolean laws above are the proven core each arm restates.
-- "corrupt" names the impossible arm — an outcome with no intent — which
-- the Go side surfaces as a structured integrity error, never as a state.
export func receiptState(hasIntent: bool, hasOutcome: bool) -> string ! {}
tests [
  ((false, false), "not-started"),
  ((true, false), "indeterminate"),
  ((true, true), "resolved"),
  ((false, true), "corrupt")
]
{
  if hasIntent then
    (if hasOutcome then "resolved" else "indeterminate")
  else
    (if hasOutcome then "corrupt" else "not-started")
}
