2026-11-12T07:01:02.5672011Z set -euo pipefail
2026-11-12T07:01:02.5672378Z # ONE pin, and it tracks current AILANG. World was pinned to v0.30.0 because the
2026-11-12T07:01:02.5672835Z # replay tests drive the released ailang as a subprocess and byte-compare its
2026-11-12T07:01:02.5673276Z # output against goldens (testdata/recorded_result.bytes, recorded_world_hash.txt)
2026-11-12T07:01:02.5673724Z # that were recorded under v0.30.0 — so the pin was assumed to be load-bearing.
2026-11-12T07:01:02.5674161Z # MEASURED 2026-09-22: it is not. All 10 replay tests reproduce the goldens
2026-11-12T07:01:02.5674576Z # byte-exactly under v0.41.0, with a discriminating control (binary unset -> 13
2026-11-12T07:01:02.5674989Z # SKIPs, so the arms really do drive the subprocess). The goldens are stable
2026-11-12T07:01:02.5675428Z # across v0.30.0 -> v0.41.0, so a second frozen artifact bought nothing and cost
2026-11-12T07:01:02.5676020Z # world eleven releases of drift against the language it exists to exercise.
2026-11-12T07:01:02.5676329Z #
2026-11-12T07:01:02.5676584Z # Pin the TAG, not `latest`: a silent bump is how a goldens mismatch or a
2026-11-12T07:01:02.5676999Z # world-package hash break arrives without a red step naming it. Moving this pin
2026-11-12T07:01:02.5677439Z # is a deliberate edit, and host/replay re-verifies the goldens on the new tag.
2026-11-12T07:01:02.5677869Z # Without AILANG_BIN, host/replay's pinnedBinary and verifygate's requirePinned
2026-11-12T07:01:02.5678265Z # t.Skip() and CI is false-green — hence the loud assert below.
2026-11-12T07:01:02.5678662Z base="https://github.com/sunholo-data/ailang/releases/download/v0.41.0"
2026-11-12T07:01:02.5679069Z curl -fsSL -o pinned.tar.gz "$base/linux.x64.ailang.tar.gz"
2026-11-12T07:01:02.5679451Z curl -fsSL -o pinned.tar.gz.sha256 "$base/linux.x64.ailang.tar.gz.sha256"
2026-11-12T07:01:02.5679861Z # the published checksum names the release asset, not our local filename
2026-11-12T07:01:02.5680262Z echo "$(cut -d' ' -f1 pinned.tar.gz.sha256)  pinned.tar.gz" | sha256sum -c -
2026-11-12T07:01:02.5680575Z mkdir -p "$HOME/.local/bin"
2026-11-12T07:01:02.5680845Z tar -xzf pinned.tar.gz -C "$HOME/.local/bin" ailang
2026-11-12T07:01:02.5681344Z chmod +x "$HOME/.local/bin/ailang"
2026-11-12T07:01:02.5681680Z # Assert the pinned version loudly so a tag drift is a red step here,
2026-11-12T07:01:02.5682017Z # not a silent goldens mismatch downstream.
2026-11-12T07:01:02.5682344Z # Same no-pipe form as the world-package install above. This site has
2026-11-12T07:01:02.5682720Z # never gone red, but only by ACCIDENT OF SIZE: `--version` is 167 bytes,
2026-11-12T07:01:02.5683093Z # which fits the 64 KiB pipe buffer, so `echo` never blocks and never
2026-11-12T07:01:02.5683459Z # takes SIGPIPE. That is a property of the output length, not of the
2026-11-12T07:01:02.5683826Z # shape — the shape is the same race, one verbose release away.
2026-11-12T07:01:02.5684147Z ver="$("$HOME/.local/bin/ailang" --version)"
2026-11-12T07:01:02.5684395Z echo "$ver"
2026-11-12T07:01:02.5684583Z case "$ver" in
2026-11-12T07:01:02.5684786Z   *'AILANG v0.41.0'*) ;;
2026-11-12T07:01:02.5685044Z   *) echo "✗ AILANG_BIN is not v0.41.0" >&2; exit 1 ;;
2026-11-12T07:01:02.5685296Z esac
2026-11-12T07:01:02.5685528Z echo "AILANG_BIN=$HOME/.local/bin/ailang" >> "$GITHUB_ENV"
