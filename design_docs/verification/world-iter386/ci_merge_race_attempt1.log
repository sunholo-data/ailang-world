2026-11-12T07:01:04.8381941Z # 9/OD-11, RATIFIED: "Yes you can install z3 on cicd".
2026-11-12T07:01:04.8382344Z # host/verifygate's shim arms run scripts/verify_ail.sh end to end. Without a solver
2026-11-12T07:01:04.8382791Z # `ai-check` reports verify.available=false and every contract vanishes from
2026-11-12T07:01:04.8383234Z # verify.results[] (V20/V27), so the gate reds at leg 1 and the accept-arms could only
2026-11-12T07:01:04.8383870Z # assert markers emitted BEFORE Z3 matters — they were green in a lane where the gate
2026-11-12T07:01:04.8384349Z # they drive was red. Same version and sha as job 1, from the workflow-level pin above.
2026-11-12T07:01:04.8384715Z Z3_DIR="z3-${Z3_VER}-x64-glibc-2.39"
2026-11-12T07:01:04.8385161Z curl -fsSL -o z3.zip "https://github.com/Z3Prover/z3/releases/download/z3-${Z3_VER}/${Z3_DIR}.zip"
2026-11-12T07:01:04.8385558Z echo "${Z3_SHA}  z3.zip" | sha256sum -c -
2026-11-12T07:01:04.8385804Z unzip -q z3.zip
2026-11-12T07:01:04.8386076Z sudo install -m 0755 "${Z3_DIR}/bin/z3" /usr/local/bin/z3
