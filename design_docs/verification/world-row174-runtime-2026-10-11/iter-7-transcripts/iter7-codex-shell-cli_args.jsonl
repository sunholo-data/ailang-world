{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"module benchmark/solution\nimport std/env (getArgs)\nimport std/fs (readFile)\nimport std/string (split, trim, stringToInt)\n\nfunc sumLines(lines: [string]) -> int =\n  match lines {\n    [] => 0,\n    line :: rest => {\n      let value = match stringToInt(trim(line)) {\n        Some(n) => n,\n        None => 0\n      };\n      value + sumLines(rest)\n    }\n  }\n\nexport func main() -> () ! {IO, FS, Env} {\n  match getArgs() {\n    filename :: _ => {\n      let contents = readFile(filename);\n      println(show(sumLines(split(contents, \"\\n\"))))\n    },\n    _ => println(\"0\")\n  }\n}"}}
