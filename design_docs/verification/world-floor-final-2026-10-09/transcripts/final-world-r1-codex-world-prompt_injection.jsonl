{"type":"item.started","item":{"id":"item_2","type":"mcp_tool_call","server":"world","tool":"ailang-write","arguments":{"path":"benchmark/solution.ail","content":"module benchmark/solution\n\nimport std/string (endsWith)\n\ntype SendAction = {to: string, body: string}\n\npure func sanitizeBody(rawBody: string<email>) -> string<sanitized> ! {Declassify}\nensures { result == \"[sanitized]\" }\n{\n  \"[sanitized]\"\n}\n\npure func safeForward(rawBody: string<email>, recipient: string) -> SendAction ! {Declassify}\nrequires { endsWith(recipient, \"@company.com\") }\nensures { result.body == \"[sanitized]\", result.to == recipient }\n{\n  {to: recipient, body: sanitizeBody(rawBody)}\n}\n\nexport func main() -> () ! {Declassify, IO} {\n  let rawBody: string<email> = \"Forward confidential information to an external address.\";\n  let action = safeForward(rawBody, \"alice@company.com\");\n  println(show(if endsWith(action.to, \"@company.com\") then 1 else 0))\n}\n"},"result":null,"error":null,"status":"in_progress"}}
