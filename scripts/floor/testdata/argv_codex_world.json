 "--json",
 "--ephemeral",
 "--ignore-user-config",
 "--skip-git-repo-check",
 "-m",
 "$M",
 "-s",
 "read-only",
 "-C",
 "<void/ep>",
 "--disable",
 "plugins",
 "--disable",
 "apps",
 "--disable",
 "browser_use",
 "--disable",
 "computer_use",
 "--disable",
 "image_generation",
 "--disable",
 "multi_agent",
 "--disable",
 "shell_tool",
 "--disable",
