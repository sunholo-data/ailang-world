[
  {
    "id": "demo-approve",
    "title": "Demo approval",
    "description": "Request exactly one pending Human.Approve. Goal, two distinct candidates and four distinct evidence kind/ref pairs are input provenance; references are not authenticated or graded here. Unknown keys, phases or malformed input refuse without effects.",
    "transitionFnFile": "packages/world-demo/approve.ail",
    "inputSchema": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "roster": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "test-invocation",
                  "recorded-effect",
                  "authored-claim",
                  "proof-envelope"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "goal",
        "candidates",
        "roster"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "refused": {
          "type": "string"
        },
        "world": {
          "type": "object"
        }
      },
      "required": [
        "world"
      ]
    },
    "access": {
      "effect": "Human.Approve",
      "scope": "worktree",
      "cost": 0
    },
    "declaredEffects": [
      {
        "effect": "Human.Approve",
        "scope": "worktree",
        "cost": 1
      }
    ]
  }
]
