module world/contracts

import world/logepoch (HashRef, sameRef)
import world/types (World, Proposal, Verification)

-- Shared pure transition predicates (Decision 1 — Contracts). These are
-- executable preconditions, not prose: verify and commit call the SAME
-- predicates so policy cannot drift between the two phases.

-- Contract 1: a proposal's inputWorld equals the current world's stateRoot.
-- TESTS-ONLY (D2, V23): a contract here reaches Proposal.evidence (an ADT) and
-- Z3-errors `unknown sort 'Proposal'` while ai-check exits 0 silently
-- (upstream sunholo-data/ailang#477). The shared-predicate body (calls sameRef)
-- is kept byte-identical to preserve the anti-drift architecture; the two
-- inline tests are its machine check.
export func proposalMatchesWorld(w: World, p: Proposal) -> bool
tests [
  ((({ revision: 0,
       stateRoot: { algo: "sha256", digest: "aa" },
       logHead: { algo: "sha256", digest: "bb" } }),
    ({ proposalHash: { algo: "sha256", digest: "ph" },
       inputWorld: { algo: "sha256", digest: "aa" },
       transitionFn: { algo: "sha256", digest: "tf" },
       goal: "g", plan: "p",
       expectedEffects: [], requiredCaps: [], evidence: [],
       confidence: 1.0 })), true),
  ((({ revision: 0,
       stateRoot: { algo: "sha256", digest: "aa" },
       logHead: { algo: "sha256", digest: "bb" } }),
    ({ proposalHash: { algo: "sha256", digest: "ph" },
       inputWorld: { algo: "sha256", digest: "zz" },
       transitionFn: { algo: "sha256", digest: "tf" },
       goal: "g", plan: "p",
       expectedEffects: [], requiredCaps: [], evidence: [],
       confidence: 1.0 })), false)
]
{
  sameRef(w.stateRoot, p.inputWorld)
}

-- Contract 2: a verification names the same proposalHash as the proposal it
-- judged. TESTS-ONLY (D2, V23): Proposal reaches an ADT ⇒ unknown sort. Body
-- unchanged (shared-predicate anti-drift); two inline tests are the machine check.
export func verificationMatchesProposal(p: Proposal, v: Verification) -> bool
tests [
  ((({ proposalHash: { algo: "sha256", digest: "ph" },
       inputWorld: { algo: "sha256", digest: "aa" },
       transitionFn: { algo: "sha256", digest: "tf" },
       goal: "g", plan: "p",
       expectedEffects: [], requiredCaps: [], evidence: [],
       confidence: 1.0 }),
    ({ proposalHash: { algo: "sha256", digest: "ph" },
       accepted: true, reason: "accepted" })), true),
  ((({ proposalHash: { algo: "sha256", digest: "ph" },
       inputWorld: { algo: "sha256", digest: "aa" },
       transitionFn: { algo: "sha256", digest: "tf" },
       goal: "g", plan: "p",
       expectedEffects: [], requiredCaps: [], evidence: [],
       confidence: 1.0 }),
    ({ proposalHash: { algo: "sha256", digest: "other" },
       accepted: true, reason: "accepted" })), false)
]
{
  sameRef(p.proposalHash, v.proposalHash)
}

-- Contract 3: commit may proceed only when the verification is accepted AND
-- both identity predicates hold (input-world match and proposal-hash match).
-- TESTS-ONLY (D2, V23): Proposal reaches an ADT ⇒ unknown sort. Body unchanged
-- (shared-predicate anti-drift); two inline tests are the machine check.
export func commitAllowed(w: World, p: Proposal, v: Verification) -> bool
tests [
  ((({ revision: 0,
       stateRoot: { algo: "sha256", digest: "aa" },
       logHead: { algo: "sha256", digest: "bb" } },
     { proposalHash: { algo: "sha256", digest: "ph" },
       inputWorld: { algo: "sha256", digest: "aa" },
       transitionFn: { algo: "sha256", digest: "tf" },
       goal: "g", plan: "p",
       expectedEffects: [], requiredCaps: [], evidence: [],
       confidence: 1.0 },
     { proposalHash: { algo: "sha256", digest: "ph" },
       accepted: true, reason: "accepted" })), true),
  ((({ revision: 0,
       stateRoot: { algo: "sha256", digest: "aa" },
       logHead: { algo: "sha256", digest: "bb" } },
     { proposalHash: { algo: "sha256", digest: "ph" },
       inputWorld: { algo: "sha256", digest: "aa" },
       transitionFn: { algo: "sha256", digest: "tf" },
       goal: "g", plan: "p",
       expectedEffects: [], requiredCaps: [], evidence: [],
       confidence: 1.0 },
     { proposalHash: { algo: "sha256", digest: "ph" },
       accepted: false, reason: "rejected" })), false)
]
{
  proposalMatchesWorld(w, p)
    && v.accepted
    && verificationMatchesProposal(p, v)
}

-- Contract 4: the resulting world increments revision by exactly one and
-- carries the supplied output-state root and next-log-head references.
-- Z3-PROVEN (D2, V24): World/HashRef contain no ADT, so the body is inlined to
-- field equality (do NOT call sameRef — an unencodable-bodied callee errors,
-- D-A/V3) and the exact `ensures` restates the full semantics.
export func isValidNextWorld(
  w: World,
  next: World,
  outputWorld: HashRef,
  nextLogHead: HashRef
) -> bool ! {}
ensures { result == (next.revision == w.revision + 1
  && next.stateRoot.algo == outputWorld.algo && next.stateRoot.digest == outputWorld.digest
  && next.logHead.algo == nextLogHead.algo && next.logHead.digest == nextLogHead.digest) }
{
  next.revision == w.revision + 1
    && next.stateRoot.algo == outputWorld.algo && next.stateRoot.digest == outputWorld.digest
    && next.logHead.algo == nextLogHead.algo && next.logHead.digest == nextLogHead.digest
}

-- Contract 5: commit boundary for one stable invocation/idempotency ID.
-- Z3-PROVEN: deliberately all-scalar because an ADT-bearing parameter makes
-- v0.30.0 report an unknown sort while ai-check exits zero.
-- Clause map to Decision 6:
--   accepted ↔ exactly one receipt: before acceptance there is no durable
--     mutation; acceptance is the point of no return, and completion remains
--     required for either value of clientDisconnected.
--   receiptCount == 0 || intentJournaled: a durable receipt has prior intent.
--   receiptCount <= 1: the stable invocation ID is idempotent.
--   not(reportedNotCommitted) || outcomeKnown: an unknown outcome cannot be
--     reported definitively as not committed.
-- Honest gaps: scalar state does not prove a wall-clock bound for the critical
-- section or the storage mechanism by which a receipt is queried/replayed;
-- receiptCount abstracts the durable, queryable receipt supplied by the host.
export func commitBoundaryHolds(
  intentJournaled: bool,
  accepted: bool,
  receiptCount: int,
  clientDisconnected: bool,
  reportedNotCommitted: bool,
  outcomeKnown: bool
) -> bool ! {}
ensures { result == (
  (not(accepted) && receiptCount == 0 || accepted && receiptCount == 1)
  && (receiptCount == 0 || intentJournaled)
  && receiptCount <= 1
  && (not(reportedNotCommitted) || outcomeKnown)
) }
{
  (not(accepted) && receiptCount == 0 || accepted && receiptCount == 1)
    && (receiptCount == 0 || intentJournaled)
    && receiptCount <= 1
    && (not(reportedNotCommitted) || outcomeKnown)
}
