module se_tools/search

-- workspace-search (queue row 228 M2, design_docs/planned/w-agent-search-and-read-cap.md
-- §3.1): search files in the episode worktree. Args {pattern, regex?, ignore_case?,
-- path?, include?, max_results?}. Effect Workspace.Read; payload = {op: "search", ...}.
-- No finish phase: the handler's output is the call's result.
--
-- Calling convention v2 (§4.1): the coordinator passes ONE string,
-- {"phase":"plan","args":<MCP/A2A arguments>}.
-- The plan answer is a world/effect-plan/v1 object with exactly one effect
-- (scope "worktree", cost 1, the descriptor's declared triple) or a zero-effect
-- refusal plan whose result is {"ok":false,"refused":...} (L7). L-ARGS: any
-- argument key outside the schema above is refused.
--
-- Self-contained by construction (row 107 Residual 7): publication checks this
-- file alone in an empty root, so it imports only std/*, which the pinned
-- capsule interpreter resolves from the binary (V59). For that reason the
-- contracted core noDotDotSegment / pathOk / inputKeyAllowed is repeated in
-- every se_tools module; host/coordinator's se-tools test holds the copies
-- byte-identical. argKeyAllowed is each tool's own schema.

import std/json (decode, encode, jo, ja, kv, js, jint, jb, jn, get, asObject, asString, asNumber, asBool, Json)
import std/string (length as strLength, startsWith, endsWith, contains)
import std/bytes (fromString, length as bytesLength)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)

-- ── Contracted pure core (Z3) ─────────────────────────────────────────────

-- No path segment is "..": the whole path, a leading "../", a trailing "/..",
-- or an inner "/../". A segment that merely starts with two dots is legal.
export func noDotDotSegment(p: string) -> bool ! {}
ensures { result == (p != ".." && not startsWith(p, "../") && not endsWith(p, "/..")
  && not contains(p, "/../")) }
tests [
  ("src/main.ail", true),
  ("..", false),
  ("../x.ail", false),
  ("a/..", false),
  ("a/../b.ail", false),
  ("..a/b.ail", true),
  ("a/..b.ail", true)
]
{
  p != ".." && not startsWith(p, "../") && not endsWith(p, "/..") && not contains(p, "/../")
}

-- The plan's path predicate (§4.5): relative, non-empty, no ".." segment, no
-- leading "-" (a hyphen-leading path is a flag-injection vector, V58). Body
-- composes the proven callee; the exact ensures restates the whole law. A
-- precondition for a clear refusal, NOT the confinement (§4.3: that is the
-- AILANG policy layer behind the broker).
export func pathOk(p: string) -> bool ! {}
ensures { result == (strLength(p) >= 1 && not startsWith(p, "/") && not startsWith(p, "-")
  && p != ".." && not startsWith(p, "../") && not endsWith(p, "/..")
  && not contains(p, "/../")) }
tests [
  ("src/main.ail", true),
  ("main.ail", true),
  ("", false),
  ("/etc/hosts", false),
  ("-policy.ail", false),
  ("../ailang/go.mod", false),
  ("a/../../b", false),
  ("a/-b.ail", true)
]
{
  strLength(p) >= 1 && not startsWith(p, "/") && not startsWith(p, "-") && noDotDotSegment(p)
}

-- L-ARGS (§4.1, §4.2): the argument keys this tool admits.
export func argKeyAllowed(k: string) -> bool ! {}
ensures { result == (k == "pattern" || k == "regex" || k == "ignore_case"
  || k == "path" || k == "include" || k == "max_results") }
tests [
  ("pattern", true),
  ("regex", true),
  ("ignore_case", true),
  ("path", true),
  ("include", true),
  ("max_results", true),
  ("Pattern", false),
  ("max_chars", false),
  ("exclude", false),
  ("", false)
]
{
  k == "pattern" || k == "regex" || k == "ignore_case"
    || k == "path" || k == "include" || k == "max_results"
}

export func maxResultsOk(n: int) -> bool ! {}
ensures { result == (n >= 1 && n <= 500) }
tests [(0, false), (1, true), (100, true), (500, true), (501, false)]
{ n >= 1 && n <= 500 }

export func patternLenOk(n: int) -> bool ! {}
ensures { result == (n >= 1 && n <= 512) }
tests [(0, false), (1, true), (512, true), (513, false)]
{ n >= 1 && n <= 512 }

-- Calling convention v2 (§4.1): the input object's keys. `results` exists only
-- in the finish phase.
export func inputKeyAllowed(phase: string, k: string) -> bool ! {}
ensures { result == (k == "phase" || k == "args" || (phase == "finish" && k == "results")) }
tests [
  (("plan", "args"), true),
  (("plan", "phase"), true),
  (("plan", "results"), false),
  (("finish", "results"), true),
  (("plan", "world"), false)
]
{
  k == "phase" || k == "args" || (phase == "finish" && k == "results")
}

-- ── Plan construction (world/effect-plan/v1, §4.1) ─────────────────────────

-- A zero-effect refusal plan: L7 requires its non-null result object, which
-- reaches the caller verbatim.
func refusal(msg: string) -> string =
  encode(jo([
    kv("plan", js("world/effect-plan/v1")),
    kv("effects", ja([])),
    kv("finish", jb(false)),
    kv("result", jo([kv("ok", jb(false)), kv("refused", js(msg))]))
  ]))

-- The one-effect plan: id "e1", scope "worktree", cost 1 — exactly a triple
-- of the descriptor's declaredEffects (L3), so parsePlan admits it.
func effectPlan(effect: string, payload: Json, finish: bool) -> string =
  encode(jo([
    kv("plan", js("world/effect-plan/v1")),
    kv("effects", ja([jo([
      kv("id", js("e1")),
      kv("effect", js(effect)),
      kv("scope", js("worktree")),
      kv("cost", jint(1)),
      kv("payload", payload)
    ])])),
    kv("finish", jb(finish)),
    kv("result", jn(()))
  ]))

func pathRefusal(p: string) -> string =
  "path \"${p}\" refused: it must be relative and non-empty, with no \"..\" segment and no leading \"-\""

func firstUnknownArg(es: [{key: string, value: Json}]) -> Option[string] =
  match es {
    [] => None,
    e :: rest => if argKeyAllowed(e.key) then firstUnknownArg(rest) else Some(e.key)
  }

func firstUnknownInputKey(es: [{key: string, value: Json}], phase: string) -> Option[string] =
  match es {
    [] => None,
    e :: rest => if inputKeyAllowed(phase, e.key) then firstUnknownInputKey(rest, phase) else Some(e.key)
  }

func requiredPattern(args: Json) -> Result[string, string] =
  match get(args, "pattern") {
    None => Err("missing required argument \"pattern\""),
    Some(v) => match asString(v) {
      Some(s) => if patternLenOk(bytesLength(fromString(s))) then Ok(s)
        else Err("argument \"pattern\" must be 1 to 512 bytes"),
      None => Err("argument \"pattern\" must be a string")
    }
  }

func optionalBool(args: Json, k: string) -> Result[Option[bool], string] =
  match get(args, k) {
    None => Ok(None),
    Some(v) => match asBool(v) {
      Some(b) => Ok(Some(b)),
      None => Err("argument \"${k}\" must be a boolean")
    }
  }

func optionalPath(args: Json) -> Result[Option[string], string] =
  match get(args, "path") {
    None => Ok(None),
    Some(v) => match asString(v) {
      Some(p) => if pathOk(p) then Ok(Some(p)) else Err(pathRefusal(p)),
      None => Err("argument \"path\" must be a string")
    }
  }

func optionalInclude(args: Json) -> Result[Option[string], string] =
  match get(args, "include") {
    None => Ok(None),
    Some(v) => match asString(v) {
      Some(s) => if strLength(s) >= 1 && not contains(s, "/") then Ok(Some(s))
        else Err("argument \"include\" must be a non-empty basename glob without \"/\""),
      None => Err("argument \"include\" must be a string")
    }
  }

func optionalMaxResults(args: Json) -> Result[Option[int], string] =
  match get(args, "max_results") {
    None => Ok(None),
    Some(v) => match asNumber(v) {
      Some(x) => {
        let n = floatToInt(x);
        if intToFloat(n) != x then Err("argument \"max_results\" must be an integer")
        else if maxResultsOk(n) then Ok(Some(n))
        else Err("argument \"max_results\" must be an integer from 1 to 500")
      },
      None => Err("argument \"max_results\" must be an integer")
    }
  }

func stringField(doc: Json, k: string) -> string =
  match get(doc, k) {
    Some(v) => match asString(v) {
      Some(s) => s,
      None => ""
    },
    None => ""
  }

func optBoolField(k: string, v: Option[bool], rest: [{key: string, value: Json}]) -> [{key: string, value: Json}] =
  match v {
    Some(b) => kv(k, jb(b)) :: rest,
    None => rest
  }

func optStrField(k: string, v: Option[string], rest: [{key: string, value: Json}]) -> [{key: string, value: Json}] =
  match v {
    Some(s) => kv(k, js(s)) :: rest,
    None => rest
  }

func optIntField(k: string, v: Option[int], rest: [{key: string, value: Json}]) -> [{key: string, value: Json}] =
  match v {
    Some(n) => kv(k, jint(n)) :: rest,
    None => rest
  }

-- ── The tool ─────────────────────────────────────────────────────────────

func planTool(args: Json) -> string =
  match requiredPattern(args) {
    Err(why) => refusal(why),
    Ok(pat) => match optionalBool(args, "regex") {
      Err(why) => refusal(why),
      Ok(re) => match optionalBool(args, "ignore_case") {
        Err(why) => refusal(why),
        Ok(ic) => match optionalPath(args) {
          Err(why) => refusal(why),
          Ok(p) => match optionalInclude(args) {
            Err(why) => refusal(why),
            Ok(inc) => match optionalMaxResults(args) {
              Err(why) => refusal(why),
              Ok(mr) => effectPlan("Workspace.Read",
                jo(kv("op", js("search")) :: kv("pattern", js(pat)) ::
                  optBoolField("regex", re,
                  optBoolField("ignore_case", ic,
                  optStrField("path", p,
                  optStrField("include", inc,
                  optIntField("max_results", mr, [])))))), false)
            }
          }
        }
      }
    }
  }

func planPhase(doc: Json) -> string =
  match get(doc, "args") {
    None => refusal("the input carries no args"),
    Some(args) => match asObject(args) {
      None => refusal("arguments must be a JSON object"),
      Some(es) => match firstUnknownArg(es) {
        Some(k) => refusal("unknown argument \"${k}\"; workspace-search admits only: pattern, regex, ignore_case, path, include, max_results"),
        None => planTool(args)
      }
    }
  }

func dispatch(doc: Json) -> string =
  match asObject(doc) {
    None => refusal("the input is not a JSON object"),
    Some(top) => {
      let phase = stringField(doc, "phase");
      match firstUnknownInputKey(top, phase) {
        Some(k) => refusal("input key \"${k}\" is not part of calling convention v2"),
        None => if phase == "plan" then planPhase(doc)
          else if phase == "finish" then encode(jo([kv("ok", jb(false)), kv("refused", js("workspace-search has no finish phase"))]))
          else refusal("phase must be \"plan\" or \"finish\"")
      }
    }
  }

export func main(input: string) -> string
tests [
  ("{\"phase\":\"plan\",\"args\":{\"pattern\":\"hello\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Workspace.Read\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"op\":\"search\",\"pattern\":\"hello\"}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"pattern\":\"foo\",\"regex\":true,\"ignore_case\":true,\"path\":\"host/broker\",\"include\":\"*.go\",\"max_results\":25}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Workspace.Read\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"op\":\"search\",\"pattern\":\"foo\",\"regex\":true,\"ignore_case\":true,\"path\":\"host/broker\",\"include\":\"*.go\",\"max_results\":25}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"pattern\":\"foo\",\"exclude\":\"*.txt\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"unknown argument \\\"exclude\\\"; workspace-search admits only: pattern, regex, ignore_case, path, include, max_results\"}}"),
  ("{\"phase\":\"plan\",\"args\":{}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"missing required argument \\\"pattern\\\"\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"pattern\":\"\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"argument \\\"pattern\\\" must be 1 to 512 bytes\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"pattern\":\"a\",\"path\":\"../secret\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"path \\\"../secret\\\" refused: it must be relative and non-empty, with no \\\"..\\\" segment and no leading \\\"-\\\"\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"pattern\":\"a\",\"max_results\":501}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"argument \\\"max_results\\\" must be an integer from 1 to 500\"}}"),
  ("{\"phase\":\"finish\",\"args\":{\"pattern\":\"a\"},\"results\":[]}",
   "{\"ok\":false,\"refused\":\"workspace-search has no finish phase\"}")
]
{
  match decode(input) {
    Ok(doc) => dispatch(doc),
    Err(e) => refusal("the input is not JSON: ${e}")
  }
}
