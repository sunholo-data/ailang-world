module se_tools/run

-- ailang-run (queue row 134, design_docs/planned/w-software-engineering-domain.md
-- §4.2-§4.3; widened by row 135, design_docs/planned/w-ailang-run-stdin-argv-caps.md
-- §4.1): run one AILANG program of the episode worktree under a rendered
-- operator policy (`ailang run --policy P [--args-json J] -- <path> [-- <argv…>]`,
-- cwd = the worktree root, stdin piped). Args {path, args_json?, stdin?, argv?,
-- caps?}; args_json is a string holding JSON, stdin a string (≤ 65 536 UTF-8
-- bytes), argv an array of ≤ 32 strings (each ≤ 1 024 bytes, no NUL), caps the
-- run's EXACT capability set: distinct names from {Declassify, Env, FS, IO,
-- Net}, never Env with Net (R-135-4). The one effect is runEffect's choice —
-- Ailang.RunEnv when Env is asked, Ailang.RunNet when Net is, otherwise
-- Ailang.Run (a Declassify-only run included, D-135-5 = A) — with payload
-- {path, args_json?, stdin?, argv?, caps?} (caps sorted). With none of the new
-- arguments the plan is byte-identical to row 134's. No finish phase: the
-- handler's {admitted, exit_code, decision, limit, stdout, stderr, policy} is
-- the result.
--
-- Calling convention v2 (§4.1): the coordinator passes ONE string,
-- {"phase":"plan","args":<MCP/A2A arguments>}.
-- The plan answer is a world/effect-plan/v1 object with exactly one effect
-- (scope "worktree", cost 1, one of the descriptor's declared triples) or a
-- zero-effect refusal plan whose result is {"ok":false,"refused":...} (L7).
-- L-ARGS: any argument key outside the schema above is refused (V56: the
-- handler would ignore it).
--
-- Self-contained by construction (row 107 Residual 7): publication checks this
-- file alone in an empty root, so it imports only std/*, which the pinned
-- capsule interpreter resolves from the binary (V59). For that reason the
-- contracted core noDotDotSegment / pathOk / inputKeyAllowed is repeated in
-- every se_tools module; host/coordinator's se-tools test holds the copies
-- byte-identical. argKeyAllowed is each tool's own schema.

import std/json (decode, encode, jo, ja, kv, js, jint, jb, jn, get, asObject, asString, asArray, Json)
import std/string (length as strLength, startsWith, endsWith, contains, compare)
import std/bytes (fromString, toInts, length as bytesLength)
import std/list (any, length as listLength, map)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)

-- ── Contracted pure core (Z3) ─────────────────────────────────────────────

-- No path segment is "..": the whole path, a leading "../", a trailing "/..",
-- or an inner "/../". A segment that merely starts with two dots is legal.
export func noDotDotSegment(p: string) -> bool ! {}
ensures { result == (p != ".." && not startsWith(p, "../") && not endsWith(p, "/..")
  && not contains(p, "/../")) }
tests [
  ("src/main.ail", true),
  ("..", false),
  ("../x.ail", false),
  ("a/..", false),
  ("a/../b.ail", false),
  ("..a/b.ail", true),
  ("a/..b.ail", true)
]
{
  p != ".." && not startsWith(p, "../") && not endsWith(p, "/..") && not contains(p, "/../")
}

-- The plan's path predicate (§4.5): relative, non-empty, no ".." segment, no
-- leading "-" (a hyphen-leading path is a flag-injection vector, V58). Body
-- composes the proven callee; the exact ensures restates the whole law. A
-- precondition for a clear refusal, NOT the confinement (§4.3: that is the
-- AILANG policy layer behind the broker).
export func pathOk(p: string) -> bool ! {}
ensures { result == (strLength(p) >= 1 && not startsWith(p, "/") && not startsWith(p, "-")
  && p != ".." && not startsWith(p, "../") && not endsWith(p, "/..")
  && not contains(p, "/../")) }
tests [
  ("src/main.ail", true),
  ("main.ail", true),
  ("", false),
  ("/etc/hosts", false),
  ("-policy.ail", false),
  ("../ailang/go.mod", false),
  ("a/../../b", false),
  ("a/-b.ail", true)
]
{
  strLength(p) >= 1 && not startsWith(p, "/") && not startsWith(p, "-") && noDotDotSegment(p)
}

-- L-ARGS (§4.1, §4.2): the argument keys this tool admits. policy-tool ignores
-- unknown request keys (V56), so strictness lives here: any other key is a
-- typed refusal plan, never silently dropped. Row 135 adds stdin, argv, caps.
export func argKeyAllowed(k: string) -> bool ! {}
ensures { result == (k == "path" || k == "args_json" || k == "stdin" || k == "argv" || k == "caps") }
tests [
  ("path", true),
  ("args_json", true),
  ("stdin", true),
  ("argv", true),
  ("caps", true),
  ("args", false),
  ("Caps", false),
  ("env", false)
]
{
  k == "path" || k == "args_json" || k == "stdin" || k == "argv" || k == "caps"
}

-- Calling convention v2 (§4.1): the input object's keys. `results` exists only
-- in the finish phase.
export func inputKeyAllowed(phase: string, k: string) -> bool ! {}
ensures { result == (k == "phase" || k == "args" || (phase == "finish" && k == "results")) }
tests [
  (("plan", "args"), true),
  (("plan", "phase"), true),
  (("plan", "results"), false),
  (("finish", "results"), true),
  (("plan", "world"), false)
]
{
  k == "phase" || k == "args" || (phase == "finish" && k == "results")
}

-- ── Row 135 contracted core (Z3): caps, effect selection, bounds ──────────

-- The capability names a run may request (§4.1). The operator's
-- --run-allow-caps narrows this per daemon; the handler enforces that.
export func capAllowed(c: string) -> bool ! {}
ensures { result == (c == "IO" || c == "FS" || c == "Env" || c == "Net" || c == "Declassify") }
tests [
  ("IO", true),
  ("FS", true),
  ("Env", true),
  ("Net", true),
  ("Declassify", true),
  ("Process", false),
  ("io", false),
  ("Clock", false)
]
{
  c == "IO" || c == "FS" || c == "Env" || c == "Net" || c == "Declassify"
}

-- Effect selection (§4.1, L1 = 1): Env picks Ailang.RunEnv, Net picks
-- Ailang.RunNet, anything else — a Declassify-only run included (D-135-5 = A)
-- — stays Ailang.Run. Env together with Net never reaches here (R-135-4).
export func runEffect(hasEnv: bool, hasNet: bool) -> string ! {}
ensures { result == (if hasEnv then "Ailang.RunEnv" else if hasNet then "Ailang.RunNet" else "Ailang.Run") }
tests [
  ((false, false), "Ailang.Run"),
  ((true, false), "Ailang.RunEnv"),
  ((false, true), "Ailang.RunNet")
]
{
  if hasEnv then "Ailang.RunEnv" else if hasNet then "Ailang.RunNet" else "Ailang.Run"
}

-- stdin is at most 65 536 UTF-8 bytes.
export func stdinBytesOk(n: int) -> bool ! {}
ensures { result == (n <= 65536) }
tests [
  (0, true),
  (65536, true),
  (65537, false)
]
{
  n <= 65536
}

-- argv holds at most 32 items.
export func argvCountOk(n: int) -> bool ! {}
ensures { result == (n <= 32) }
tests [
  (0, true),
  (32, true),
  (33, false)
]
{
  n <= 32
}

-- Each argv item is at most 1 024 UTF-8 bytes.
export func argBytesOk(n: int) -> bool ! {}
ensures { result == (n <= 1024) }
tests [
  (0, true),
  (1024, true),
  (1025, false)
]
{
  n <= 1024
}

-- ── Plan construction (world/effect-plan/v1, §4.1) ─────────────────────────

-- A zero-effect refusal plan: L7 requires its non-null result object, which
-- reaches the caller verbatim.
func refusal(msg: string) -> string =
  encode(jo([
    kv("plan", js("world/effect-plan/v1")),
    kv("effects", ja([])),
    kv("finish", jb(false)),
    kv("result", jo([kv("ok", jb(false)), kv("refused", js(msg))]))
  ]))

-- The one-effect plan: id "e1", scope "worktree", cost 1 — exactly a triple
-- of the descriptor's declaredEffects (L3), so parsePlan admits it.
func effectPlan(effect: string, payload: Json, finish: bool) -> string =
  encode(jo([
    kv("plan", js("world/effect-plan/v1")),
    kv("effects", ja([jo([
      kv("id", js("e1")),
      kv("effect", js(effect)),
      kv("scope", js("worktree")),
      kv("cost", jint(1)),
      kv("payload", payload)
    ])])),
    kv("finish", jb(finish)),
    kv("result", jn(()))
  ]))

func pathRefusal(p: string) -> string =
  "path \"${p}\" refused: it must be relative and non-empty, with no \"..\" segment and no leading \"-\""

func firstUnknownArg(es: [{key: string, value: Json}]) -> Option[string] =
  match es {
    [] => None,
    e :: rest => if argKeyAllowed(e.key) then firstUnknownArg(rest) else Some(e.key)
  }

func firstUnknownInputKey(es: [{key: string, value: Json}], phase: string) -> Option[string] =
  match es {
    [] => None,
    e :: rest => if inputKeyAllowed(phase, e.key) then firstUnknownInputKey(rest, phase) else Some(e.key)
  }

func requiredString(args: Json, k: string) -> Result[string, string] =
  match get(args, k) {
    None => Err("missing required argument \"${k}\""),
    Some(v) => match asString(v) {
      Some(s) => Ok(s),
      None => Err("argument \"${k}\" must be a string")
    }
  }

func stringField(doc: Json, k: string) -> string =
  match get(doc, k) {
    Some(v) => match asString(v) {
      Some(s) => s,
      None => ""
    },
    None => ""
  }

-- An optional string argument: absent is Ok(None); present but not a string
-- is refused.
func optionalString(args: Json, k: string) -> Result[Option[string], string] =
  match get(args, k) {
    None => Ok(None),
    Some(v) => match asString(v) {
      Some(s) => Ok(Some(s)),
      None => Err("argument \"${k}\" must be a string")
    }
  }

-- ── The tool ─────────────────────────────────────────────────────────────

func utf8Bytes(s: string) -> int = bytesLength(fromString(s))

func hasNul(s: string) -> bool = any(\b. b == 0, toInts(fromString(s)))

func argvShape() -> string = "argument \"argv\" must be an array of strings"

func capsShape() -> string = "argument \"caps\" must be an array of capability names"

func optionalArray(args: Json, k: string, shape: string) -> Result[Option[[Json]], string] =
  match get(args, k) {
    None => Ok(None),
    Some(v) => match asArray(v) {
      Some(xs) => Ok(Some(xs)),
      None => Err(shape)
    }
  }

func checkStdin(stdin: Option[string]) -> Result[Option[string], string] =
  match stdin {
    None => Ok(None),
    Some(s) => if stdinBytesOk(utf8Bytes(s)) then Ok(Some(s))
      else Err("argument \"stdin\" is ${show(utf8Bytes(s))} bytes; the limit is 65536")
  }

@allow_empty_ok("an empty argv array is a legitimate, distinct request: the program gets no arguments")
func argvItems(items: [Json]) -> Result[[string], string] =
  match items {
    [] => Ok([]),
    x :: rest => match asString(x) {
      None => Err(argvShape()),
      Some(s) => if not argBytesOk(utf8Bytes(s)) then Err("an argv item is ${show(utf8Bytes(s))} bytes; the limit is 1024")
        else if hasNul(s) then Err("an argv item contains a NUL byte")
        else match argvItems(rest) {
          Ok(ss) => Ok(s :: ss),
          Err(why) => Err(why)
        }
    }
  }

func parseArgv(args: Json) -> Result[Option[[string]], string] =
  match optionalArray(args, "argv", argvShape()) {
    Err(why) => Err(why),
    Ok(None) => Ok(None),
    Ok(Some(items)) => if not argvCountOk(listLength(items)) then Err("argument \"argv\" has ${show(listLength(items))} items; the limit is 32")
      else match argvItems(items) {
        Ok(ss) => Ok(Some(ss)),
        Err(why) => Err(why)
      }
  }

func capItems(items: [Json], seen: [string]) -> Result[[string], string] =
  match items {
    [] => Ok(seen),
    x :: rest => match asString(x) {
      None => Err(capsShape()),
      Some(c) => if not capAllowed(c) then Err("unknown capability \"${c}\"; caps admits only: Declassify, Env, FS, IO, Net")
        else if any(\s. s == c, seen) then Err("capability \"${c}\" is listed twice")
        else capItems(rest, c :: seen)
    }
  }

-- Insertion into an ascending list (caps hold at most five names).
func insertSorted(c: string, cs: [string]) -> [string] =
  match cs {
    [] => [c],
    x :: rest => if compare(c, x) < 0 then c :: cs else x :: insertSorted(c, rest)
  }

func sortCaps(cs: [string]) -> [string] =
  match cs {
    [] => [],
    x :: rest => insertSorted(x, sortCaps(rest))
  }

func hasCap(caps: Option[[string]], c: string) -> bool =
  match caps {
    None => false,
    Some(cs) => any(\s. s == c, cs)
  }

-- caps, canonicalised (sorted; a duplicate was refused): an empty set is
-- refused (a run names what it may do), and so is Env with Net (R-135-4).
func parseCaps(args: Json) -> Result[Option[[string]], string] =
  match optionalArray(args, "caps", capsShape()) {
    Err(why) => Err(why),
    Ok(None) => Ok(None),
    Ok(Some(items)) => match capItems(items, []) {
      Err(why) => Err(why),
      Ok(cs) => if listLength(cs) == 0 then Err("argument \"caps\" names no capability")
        else if any(\s. s == "Env", cs) && any(\s. s == "Net", cs) then Err("caps names both Env and Net; one run takes at most one of them")
        else Ok(Some(sortCaps(cs)))
    }
  }

func optKv(k: string, v: Option[Json]) -> [{key: string, value: Json}] =
  match v {
    None => [],
    Some(j) => [kv(k, j)]
  }

func optStrings(xs: Option[[string]]) -> Option[Json] =
  match xs {
    None => None,
    Some(ss) => Some(ja(map(js, ss)))
  }

func optString(x: Option[string]) -> Option[Json] =
  match x {
    None => None,
    Some(s) => Some(js(s))
  }

func runPayload(path: string, argsJSON: Option[string], stdin: Option[string], argv: Option[[string]], caps: Option[[string]]) -> Json =
  jo([kv("path", js(path))] ++ optKv("args_json", optString(argsJSON)) ++ optKv("stdin", optString(stdin))
    ++ optKv("argv", optStrings(argv)) ++ optKv("caps", optStrings(caps)))

func planRun(args: Json, path: string, argsJSON: Option[string]) -> string =
  match optionalString(args, "stdin") {
    Err(why) => refusal(why),
    Ok(rawStdin) => match checkStdin(rawStdin) {
      Err(why) => refusal(why),
      Ok(stdin) => match parseArgv(args) {
        Err(why) => refusal(why),
        Ok(argv) => match parseCaps(args) {
          Err(why) => refusal(why),
          Ok(caps) => effectPlan(runEffect(hasCap(caps, "Env"), hasCap(caps, "Net")),
            runPayload(path, argsJSON, stdin, argv, caps), false)
        }
      }
    }
  }

func planTool(args: Json) -> string =
  match requiredString(args, "path") {
    Err(why) => refusal(why),
    Ok(path) => match optionalString(args, "args_json") {
      Err(why) => refusal(why),
      Ok(argsJSON) => if not pathOk(path) then refusal(pathRefusal(path))
        else match argsJSON {
          None => planRun(args, path, None),
          Some(j) => match decode(j) {
            Ok(_) => planRun(args, path, Some(j)),
            Err(_) => refusal("argument \"args_json\" must be a string holding JSON")
          }
        }
    }
  }

func planPhase(doc: Json) -> string =
  match get(doc, "args") {
    None => refusal("the input carries no args"),
    Some(args) => match asObject(args) {
      None => refusal("arguments must be a JSON object"),
      Some(es) => match firstUnknownArg(es) {
        Some(k) => refusal("unknown argument \"${k}\"; ailang-run admits only: path, args_json, stdin, argv, caps"),
        None => planTool(args)
      }
    }
  }

func dispatch(doc: Json) -> string =
  match asObject(doc) {
    None => refusal("the input is not a JSON object"),
    Some(top) => {
      let phase = stringField(doc, "phase");
      match firstUnknownInputKey(top, phase) {
        Some(k) => refusal("input key \"${k}\" is not part of calling convention v2"),
        None => if phase == "plan" then planPhase(doc)
          else if phase == "finish" then encode(jo([kv("ok", jb(false)), kv("refused", js("ailang-run has no finish phase"))]))
          else refusal("phase must be \"plan\" or \"finish\"")
      }
    }
  }

-- The transition entry (calling convention v2). Its named tests pin the exact
-- plan bytes for an admitted call and each L-ARGS / path refusal, and (row 135
-- AC1.1) each stdin / argv / caps case: the effect choice, the canonical caps,
-- every bound and refusal. The 1 025-byte argv item and the 65 537-byte stdin
-- are pinned by host/coordinator's se-tools test (too large for a literal).
export func main(input: string) -> string
tests [
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"args.ail\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Ailang.Run\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"path\":\"args.ail\"}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"args.ail\",\"limit\":5}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"unknown argument \\\"limit\\\"; ailang-run admits only: path, args_json, stdin, argv, caps\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"args.ail\"},\"world\":{}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"input key \\\"world\\\" is not part of calling convention v2\"}}"),
  ("{\"phase\":\"plan\",\"args\":[]}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"arguments must be a JSON object\"}}"),
  ("{\"phase\":\"replay\",\"args\":{\"path\":\"args.ail\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"phase must be \\\"plan\\\" or \\\"finish\\\"\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"args.ail\",\"args_json\":\"\\\"data.txt\\\"\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Ailang.Run\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"path\":\"args.ail\",\"args_json\":\"\\\"data.txt\\\"\"}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"args.ail\",\"args_json\":\"{not json\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"argument \\\"args_json\\\" must be a string holding JSON\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"args.ail\",\"args_json\":3}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"argument \\\"args_json\\\" must be a string\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"-policy.ail\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"path \\\"-policy.ail\\\" refused: it must be relative and non-empty, with no \\\"..\\\" segment and no leading \\\"-\\\"\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"x.ail\",\"caps\":\"IO,Net\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"argument \\\"caps\\\" must be an array of capability names\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"pipeline.ail\",\"caps\":[\"IO\"],\"stdin\":\"1\\n2\\n3\\n4\\n5\\n\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Ailang.Run\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"path\":\"pipeline.ail\",\"stdin\":\"1\\n2\\n3\\n4\\n5\\n\",\"caps\":[\"IO\"]}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"args.ail\",\"argv\":[\"numbers.txt\"]}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Ailang.Run\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"path\":\"args.ail\",\"argv\":[\"numbers.txt\"]}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"sum.ail\",\"caps\":[\"IO\",\"FS\",\"Env\"],\"argv\":[\"numbers.txt\"]}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Ailang.RunEnv\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"path\":\"sum.ail\",\"argv\":[\"numbers.txt\"],\"caps\":[\"Env\",\"FS\",\"IO\"]}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"api.ail\",\"caps\":[\"Net\",\"IO\"]}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Ailang.RunNet\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"path\":\"api.ail\",\"caps\":[\"IO\",\"Net\"]}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"pi.ail\",\"caps\":[\"IO\",\"Declassify\"]}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Ailang.Run\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"path\":\"pi.ail\",\"caps\":[\"Declassify\",\"IO\"]}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"x.ail\",\"caps\":[\"IO\",\"Env\",\"Net\"]}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"caps names both Env and Net; one run takes at most one of them\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"x.ail\",\"caps\":[\"IO\",\"Process\"]}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"unknown capability \\\"Process\\\"; caps admits only: Declassify, Env, FS, IO, Net\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"x.ail\",\"caps\":[\"IO\",\"io\"]}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"unknown capability \\\"io\\\"; caps admits only: Declassify, Env, FS, IO, Net\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"x.ail\",\"caps\":[\"IO\",\"Net\",\"IO\"]}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"capability \\\"IO\\\" is listed twice\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"x.ail\",\"caps\":[]}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"argument \\\"caps\\\" names no capability\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"x.ail\",\"caps\":[\"IO\",7]}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"argument \\\"caps\\\" must be an array of capability names\"}}"),
