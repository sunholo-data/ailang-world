module se_tools/read

-- ailang-read (queue row 134, design_docs/planned/w-software-engineering-domain.md
-- §4.2): read one file of the episode worktree. Args {path, offset?, limit?}.
-- Effect Workspace.Read; payload = the policy-tool `read` request
-- {op, path, offset?, limit?}. Row 190: offset (1-based first line) and limit
-- (line count) go through only when given; v0.54.15's policy-tool then
-- answers with total_lines, offset and limit too, and caps limit at 2000
-- itself (ailang#1872), so the plan leaves the cap upstream.
-- No finish phase: the handler's output is the call's result.
--
-- Calling convention v2 (§4.1): the coordinator passes ONE string,
-- {"phase":"plan","args":<MCP/A2A arguments>}.
-- The plan answer is a world/effect-plan/v1 object with exactly one effect
-- (scope "worktree", cost 1, the descriptor's declared triple) or a zero-effect
-- refusal plan whose result is {"ok":false,"refused":...} (L7). L-ARGS: any
-- argument key outside the schema above is refused (V56: the handler would
-- ignore it).
--
-- Self-contained by construction (row 107 Residual 7): publication checks this
-- file alone in an empty root, so it imports only std/*, which the pinned
-- capsule interpreter resolves from the binary (V59). For that reason the
-- contracted core noDotDotSegment / pathOk / inputKeyAllowed is repeated in
-- every se_tools module; host/coordinator's se-tools test holds the copies
-- byte-identical. argKeyAllowed is each tool's own schema.

import std/json (decode, encode, jo, ja, kv, js, jint, jb, jn, get, asObject, asString, Json, JNumber)
import std/string (length as strLength, startsWith, endsWith, contains)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)

-- ── Contracted pure core (Z3) ─────────────────────────────────────────────

-- No path segment is "..": the whole path, a leading "../", a trailing "/..",
-- or an inner "/../". A segment that merely starts with two dots is legal.
export func noDotDotSegment(p: string) -> bool ! {}
ensures { result == (p != ".." && not startsWith(p, "../") && not endsWith(p, "/..")
  && not contains(p, "/../")) }
tests [
  ("src/main.ail", true),
  ("..", false),
  ("../x.ail", false),
  ("a/..", false),
  ("a/../b.ail", false),
  ("..a/b.ail", true),
  ("a/..b.ail", true)
]
{
  p != ".." && not startsWith(p, "../") && not endsWith(p, "/..") && not contains(p, "/../")
}

-- The plan's path predicate (§4.5): relative, non-empty, no ".." segment, no
-- leading "-" (a hyphen-leading path is a flag-injection vector, V58). Body
-- composes the proven callee; the exact ensures restates the whole law. A
-- precondition for a clear refusal, NOT the confinement (§4.3: that is the
-- AILANG policy layer behind the broker).
export func pathOk(p: string) -> bool ! {}
ensures { result == (strLength(p) >= 1 && not startsWith(p, "/") && not startsWith(p, "-")
  && p != ".." && not startsWith(p, "../") && not endsWith(p, "/..")
  && not contains(p, "/../")) }
tests [
  ("src/main.ail", true),
  ("main.ail", true),
  ("", false),
  ("/etc/hosts", false),
  ("-policy.ail", false),
  ("../ailang/go.mod", false),
  ("a/../../b", false),
  ("a/-b.ail", true)
]
{
  strLength(p) >= 1 && not startsWith(p, "/") && not startsWith(p, "-") && noDotDotSegment(p)
}

-- L-ARGS (§4.1, §4.2): the argument keys this tool admits. policy-tool ignores
-- unknown request keys (V56), so strictness lives here: any other key is a
-- typed refusal plan, never silently dropped. (v0.54.15 refuses unknown keys
-- itself; the plan still refuses first, so the refusal names the tool.)
export func argKeyAllowed(k: string) -> bool ! {}
ensures { result == (k == "path" || k == "offset" || k == "limit") }
tests [
  ("path", true),
  ("offset", true),
  ("limit", true),
  ("Path", false),
  ("Offset", false),
  ("content", false),
  ("", false)
]
{
  k == "path" || k == "offset" || k == "limit"
}

-- Row 190: a range value the plan admits. offset is 1-based and limit counts
-- lines, so both must be at least 1 (v0.54.15 refuses 0 and below for both,
-- measured). No upper bound: policy-tool clamps limit to 2000 silently and
-- answers an offset past the end with no content.
export func lineArgOk(n: int) -> bool ! {}
ensures { result == (n >= 1) }
tests [
  (1, true),
  (2000, true),
  (2001, true),
  (0, false),
  (-1, false)
]
{
  n >= 1
}

-- Calling convention v2 (§4.1): the input object's keys. `results` exists only
-- in the finish phase.
export func inputKeyAllowed(phase: string, k: string) -> bool ! {}
ensures { result == (k == "phase" || k == "args" || (phase == "finish" && k == "results")) }
tests [
  (("plan", "args"), true),
  (("plan", "phase"), true),
  (("plan", "results"), false),
  (("finish", "results"), true),
  (("plan", "world"), false)
]
{
  k == "phase" || k == "args" || (phase == "finish" && k == "results")
}

-- ── Plan construction (world/effect-plan/v1, §4.1) ─────────────────────────

-- A zero-effect refusal plan: L7 requires its non-null result object, which
-- reaches the caller verbatim.
func refusal(msg: string) -> string =
  encode(jo([
    kv("plan", js("world/effect-plan/v1")),
    kv("effects", ja([])),
    kv("finish", jb(false)),
    kv("result", jo([kv("ok", jb(false)), kv("refused", js(msg))]))
  ]))

-- The one-effect plan: id "e1", scope "worktree", cost 1 — exactly a triple
-- of the descriptor's declaredEffects (L3), so parsePlan admits it.
func effectPlan(effect: string, payload: Json, finish: bool) -> string =
  encode(jo([
    kv("plan", js("world/effect-plan/v1")),
    kv("effects", ja([jo([
      kv("id", js("e1")),
      kv("effect", js(effect)),
      kv("scope", js("worktree")),
      kv("cost", jint(1)),
      kv("payload", payload)
    ])])),
    kv("finish", jb(finish)),
    kv("result", jn(()))
  ]))

func pathRefusal(p: string) -> string =
  "path \"${p}\" refused: it must be relative and non-empty, with no \"..\" segment and no leading \"-\""

func firstUnknownArg(es: [{key: string, value: Json}]) -> Option[string] =
  match es {
    [] => None,
    e :: rest => if argKeyAllowed(e.key) then firstUnknownArg(rest) else Some(e.key)
  }

func firstUnknownInputKey(es: [{key: string, value: Json}], phase: string) -> Option[string] =
  match es {
    [] => None,
    e :: rest => if inputKeyAllowed(phase, e.key) then firstUnknownInputKey(rest, phase) else Some(e.key)
  }

func requiredString(args: Json, k: string) -> Result[string, string] =
  match get(args, k) {
    None => Err("missing required argument \"${k}\""),
    Some(v) => match asString(v) {
      Some(s) => Ok(s),
      None => Err("argument \"${k}\" must be a string")
    }
  }

func stringField(doc: Json, k: string) -> string =
  match get(doc, k) {
    Some(v) => match asString(v) {
      Some(s) => s,
      None => ""
    },
    None => ""
  }

-- An optional range argument (row 190): absent, or a JSON integer that
-- lineArgOk admits. A JSON number decodes as a float, so an integer is one
-- that survives the round trip through int (1.5 does not; 2.0 is sent as 2).
func optionalLine(args: Json, k: string) -> Result[Option[int], string] =
  match get(args, k) {
    None => Ok(None),
    Some(JNumber(x)) => {
      let n = floatToInt(x);
      if intToFloat(n) != x then Err("argument \"${k}\" must be an integer")
      else if lineArgOk(n) then Ok(Some(n))
      else Err("argument \"${k}\" must be an integer >= 1 (got ${show(n)})")
    },
    Some(_) => Err("argument \"${k}\" must be an integer")
  }

func optionalField(k: string, v: Option[int], rest: [{key: string, value: Json}]) -> [{key: string, value: Json}] =
  match v {
    Some(n) => kv(k, jint(n)) :: rest,
    None => rest
  }

-- ── The tool ─────────────────────────────────────────────────────────────

func planTool(args: Json) -> string =
  match requiredString(args, "path") {
    Err(why) => refusal(why),
    Ok(path) => if not pathOk(path) then refusal(pathRefusal(path))
      else match optionalLine(args, "offset") {
        Err(why) => refusal(why),
        Ok(offset) => match optionalLine(args, "limit") {
          Err(why) => refusal(why),
          Ok(limit) => effectPlan("Workspace.Read",
            jo(kv("op", js("read")) :: kv("path", js(path)) ::
              optionalField("offset", offset, optionalField("limit", limit, []))), false)
        }
      }
  }

func planPhase(doc: Json) -> string =
  match get(doc, "args") {
    None => refusal("the input carries no args"),
    Some(args) => match asObject(args) {
      None => refusal("arguments must be a JSON object"),
      Some(es) => match firstUnknownArg(es) {
        Some(k) => refusal("unknown argument \"${k}\"; ailang-read admits only: path, offset, limit"),
        None => planTool(args)
      }
    }
  }

func dispatch(doc: Json) -> string =
  match asObject(doc) {
    None => refusal("the input is not a JSON object"),
    Some(top) => {
      let phase = stringField(doc, "phase");
      match firstUnknownInputKey(top, phase) {
        Some(k) => refusal("input key \"${k}\" is not part of calling convention v2"),
        None => if phase == "plan" then planPhase(doc)
          else if phase == "finish" then encode(jo([kv("ok", jb(false)), kv("refused", js("ailang-read has no finish phase"))]))
          else refusal("phase must be \"plan\" or \"finish\"")
      }
    }
  }

-- The transition entry (calling convention v2). Its named tests pin the exact
-- plan bytes for an admitted call, ranged calls (row 190) and each L-ARGS /
-- range / path refusal.
export func main(input: string) -> string
tests [
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"src/main.ail\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Workspace.Read\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"op\":\"read\",\"path\":\"src/main.ail\"}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"docs/big.md\",\"offset\":201,\"limit\":100}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Workspace.Read\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"op\":\"read\",\"path\":\"docs/big.md\",\"offset\":201,\"limit\":100}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"limit\":50,\"path\":\"docs/big.md\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Workspace.Read\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"op\":\"read\",\"path\":\"docs/big.md\",\"limit\":50}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"docs/big.md\",\"offset\":2.0}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[{\"id\":\"e1\",\"effect\":\"Workspace.Read\",\"scope\":\"worktree\",\"cost\":1,\"payload\":{\"op\":\"read\",\"path\":\"docs/big.md\",\"offset\":2}}],\"finish\":false,\"result\":null}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"src/main.ail\",\"lines\":5}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"unknown argument \\\"lines\\\"; ailang-read admits only: path, offset, limit\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"src/main.ail\",\"offset\":1.5}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"argument \\\"offset\\\" must be an integer\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"src/main.ail\",\"limit\":\"5\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"argument \\\"limit\\\" must be an integer\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"src/main.ail\",\"offset\":-1}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"argument \\\"offset\\\" must be an integer >= 1 (got -1)\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"src/main.ail\",\"limit\":0}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"argument \\\"limit\\\" must be an integer >= 1 (got 0)\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"src/main.ail\"},\"world\":{}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"input key \\\"world\\\" is not part of calling convention v2\"}}"),
  ("{\"phase\":\"plan\",\"args\":[]}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"arguments must be a JSON object\"}}"),
  ("{\"phase\":\"replay\",\"args\":{\"path\":\"src/main.ail\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"phase must be \\\"plan\\\" or \\\"finish\\\"\"}}"),
  ("{\"phase\":\"plan\",\"args\":{}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"missing required argument \\\"path\\\"\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":7}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"argument \\\"path\\\" must be a string\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"../ailang/go.mod\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"path \\\"../ailang/go.mod\\\" refused: it must be relative and non-empty, with no \\\"..\\\" segment and no leading \\\"-\\\"\"}}"),
  ("{\"phase\":\"plan\",\"args\":{\"path\":\"-policy.ail\"}}",
   "{\"plan\":\"world/effect-plan/v1\",\"effects\":[],\"finish\":false,\"result\":{\"ok\":false,\"refused\":\"path \\\"-policy.ail\\\" refused: it must be relative and non-empty, with no \\\"..\\\" segment and no leading \\\"-\\\"\"}}"),
  ("{\"phase\":\"finish\",\"args\":{\"path\":\"a\"},\"results\":[]}",
   "{\"ok\":false,\"refused\":\"ailang-read has no finish phase\"}")
]
{
  match decode(input) {
    Ok(doc) => dispatch(doc),
    Err(e) => refusal("the input is not JSON: ${e}")
  }
}
