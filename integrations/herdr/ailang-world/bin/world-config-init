#!/bin/sh
# world-config-init [--config-dir <dir>]: write world.env once, from defaults,
# print it, and ask you to edit it. It never overwrites an existing file.
# <dir> defaults to $HERDR_PLUGIN_CONFIG_DIR (herdr sets it for the action).
set -u
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/lib/world.sh"

dir=${HERDR_PLUGIN_CONFIG_DIR:-}
if [ "${1:-}" = --config-dir ]; then
  [ $# -ge 2 ] || world_die "--config-dir needs a directory." \
    "usage: world-config-init [--config-dir <dir>]" "pass --config-dir <dir>"
  dir=$2
elif [ $# -gt 0 ]; then
  world_die "unknown argument $1." "usage: world-config-init [--config-dir <dir>]" \
    "run it with no argument from herdr, or with --config-dir <dir>"
fi
if [ -z "$dir" ]; then
  world_die "no config directory: HERDR_PLUGIN_CONFIG_DIR is not set." \
    "world.env lives in the plugin's herdr config directory." \
    "run herdr's \"World: write config\" action, or pass --config-dir <dir>"
fi
env_file=$dir/world.env
if [ -e "$env_file" ]; then
  world_die "$env_file already exists." \
    "world-config-init writes it once and never overwrites your edits." \
    "edit $env_file, or move it aside and run world-config-init again"
fi

worldd=$(command -v ailang-worldd 2>/dev/null || :)
[ -n "$worldd" ] || worldd="$HOME/go/bin/ailang-worldd"
addr=http://127.0.0.1:7644
db=$HOME/.ailang/world/world.db
ws=$HOME/.ailang/world-ws
sessions=$HOME/.ailang/world/sessions
record=$HOME/.ailang-world/service.json
if [ -e "$record" ]; then
  if [ ! -r "$record" ]; then
    printf 'note: %s is unreadable; using defaults.\n' "$record" >&2
  elif ! command -v jq >/dev/null 2>&1; then
    printf 'note: %s cannot be read without jq; using defaults.\n' "$record" >&2
  elif jq -e '.schema == "world/service/v1" and .uninstalled != true
      and (.address | type == "string" and test("^(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+$"))
      and ([.binary,.store,.workspace] | all(type == "string" and length > 0))' "$record" >/dev/null 2>&1; then
    worldd=$(jq -r .binary "$record")
    addr=http://$(jq -r .address "$record")
    db=$(jq -r .store "$record")
    ws=$(jq -r .workspace "$record")
    sessions=$(dirname -- "$db")/sessions
    printf 'World defaults came from %s.\n' "$record"
  else
    printf 'note: %s is invalid or uninstalled (expected world/service/v1 and a loopback address); using defaults.\n' "$record" >&2
  fi
fi
# Escape record data for the double-quoted assignments in the sourced file.
config_escape() { printf '%s' "$1" | sed 's/[\\$`"]/\\&/g'; }
worldd=$(config_escape "$worldd")
addr=$(config_escape "$addr")
db=$(config_escape "$db")
ws=$(config_escape "$ws")
sessions=$(config_escape "$sessions")

mkdir -p "$dir" || world_die "cannot create $dir." "world.env is written there." "check $dir's parent and permissions"
tmp=$env_file.tmp.$$
(
  umask 077
  cat >"$tmp" <<EOF
# ailang-world herdr plugin config: sourced by sh. Written by world-config-init.
# Edit every value below; nothing here is a secret (sessions stay in their files).

# The ailang-worldd binary, and the daemon it talks to.
WORLDD="$worldd"
WORLD_ADDR="$addr"
# World's store, workspace root and session directory (episode start's --db,
# --workspace-root and --sessions-dir).
WORLD_DB="$db"
WORLD_WS="$ws"
WORLD_SESSIONS="$sessions"
# Where ailang-worldd hosts init wrote the launchers (bin/claude-world, ...).
WORLD_HOSTS="\$HOME/.ailang-world/hosts"

# The default exec profile (episode start --profile; empty for none), the
# session lifetime in seconds, and the grants: one --grant per se-tools effect,
# scope worktree. Check the budgets against your rig's mint.
WORLD_PROFILE=""
WORLD_TTL="3600"
WORLD_GRANTS="--grant Workspace.Read=worktree:200 --grant Workspace.Write=worktree:200 --grant Workspace.Delete=worktree:50 --grant Ailang.Check=worktree:100 --grant Ailang.Run=worktree:50 --grant Ailang.RunEnv=worktree:50 --grant Ailang.RunNet=worktree:50 --grant Ailang.Discover=worktree:100 --grant Ailang.CLI=worktree:100 --grant Workspace.Exec=worktree:100"

# One line per herdr workspace: <workspace label>=<repo path>[:<exec profile>].
# A workspace with no line here gets no World agent.
WORLD_REPOS="
ailang-world=\$HOME/dev/ailang-world:ailang-world
"

# The model episode start names for each host (empty: the host's default).
WORLD_MODELS="claude=claude-opus-5-5 codex=gpt-6.1-sol pi="

# Optional: the keys "World: install key bindings" (bin/world-keys) adds to
# herdr's config, for New World agent, New plain agent and the World panel.
# WORLD_KEYS="agent=prefix+shift+a plain=prefix+shift+l panel=prefix+shift+o"
EOF
) && mv "$tmp" "$env_file" || {
  rm -f "$tmp"
  world_die "cannot write $env_file." "world.env is written there." "check $dir's permissions"
}

cat "$env_file"
printf '\nWrote %s (0600). Edit it now: WORLD_REPOS for your herdr workspaces, every path, and the grant budgets.\n' "$env_file"
if [ -n "${HERDR_BIN_PATH:-}" ] && [ -x "$HERDR_BIN_PATH" ]; then
  world_notify "ailang-world" "Wrote $env_file. Edit it: WORLD_REPOS, the paths and the grant budgets."
fi
